//@version=6
indicator("Trend Following Claud", "Trend Following Claud", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 500)

// Chandelier Exit 1
groupCE1 = "Chandelier Exit 1"
showCE1 = input.bool(true, "Show CE1", group = groupCE1)
timeframeCE1 = input.timeframe("60", "Timeframe", group = groupCE1)
atrPeriodCE1 = input.int(22, "ATR Period", minval = 1, group = groupCE1)
atrMultiplierCE1Band1 = input.float(4.5, "ATR Multiplier Band 1", minval = 0.0, step = 0.1, group = groupCE1)
atrMultiplierCE1Band2 = input.float(4.5, "ATR Multiplier Band 2", minval = 0.0, step = 0.1, group = groupCE1)
lookbackCE1 = input.int(22, "Lookback Period", minval = 1, group = groupCE1)

// Chandelier Exit 2
groupCE2 = "Chandelier Exit 2"
showCE2 = input.bool(false, "Show CE2", group = groupCE2)
timeframeCE2 = input.timeframe("60", "Timeframe", group = groupCE2)
atrPeriodCE2 = input.int(22, "ATR Period", minval = 1, group = groupCE2)
atrMultiplierCE2Band1 = input.float(4.5, "ATR Multiplier Band 1", minval = 0.0, step = 0.1, group = groupCE2)
atrMultiplierCE2Band2 = input.float(4.5, "ATR Multiplier Band 2", minval = 0.0, step = 0.1, group = groupCE2)
lookbackCE2 = input.int(22, "Lookback Period", minval = 1, group = groupCE2)

// Moving average
