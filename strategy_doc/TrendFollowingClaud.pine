showMA = input.bool(true, "Show MA", group = groupMA)
timeframeMA = input.timeframe("15", "Timeframe", group = groupMA)
maPeriod = input.int(200, "Period", minval = 1, group = groupMA)
maMethod = input.string("LWMA", "Method", options = ["SMA", "EMA", "SMMA (RMA)", "LWMA"], group = groupMA)
maSource = input.source(close, "Source", group = groupMA)

