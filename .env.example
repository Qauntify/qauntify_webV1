# SEA-LION API keys — get them at https://playground.sea-lion.ai (Google sign-in)
# Symbols are spread across keys round-robin; add as many as you have.
# (SEALION_API_KEYS=key1,key2 and plain SEALION_API_KEY also work.)
SEALION_API_KEY1=your-sealion-key-here
SEALION_API_KEY2=
SEALION_API_KEY3=
SEALION_API_KEY4=

# Supabase project — Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Telegram signal alerts (optional — skipped when empty).
# Bot token from @BotFather; channel id from your Telegram channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Separate chat for ops alerts (optional — skipped when empty). Same bot as
# TELEGRAM_BOT_TOKEN, different channel/chat id. Used by:
# - session_healthcheck (silent session)
# - Vercel cron dispatch failures (/api/cron/*)
# - GitHub Actions workflow failures (scripts/notify_cron_failure.sh)
# Never set this to TELEGRAM_CHANNEL_ID — keep ops noise off the public feed.
TELEGRAM_ALERTS_CHAT_ID=

# After applying supabase/schema.sql (playbook_chunks + match_playbook_chunks),
# seed vector playbook once: python -m signals.rag.seed
# (Local keyword playbook works even before seeding.)

# Trading Floor / War Room — separate desks from SEALION_API_KEY1–4.
# Do not reuse strategy-engine keys here.
FLOOR_LLM_API_KEY_TECHNICAL=
FLOOR_LLM_API_KEY_MACRO=
FLOOR_LLM_API_KEY_NEWS=
FLOOR_LLM_BASE_URL=https://api.sea-lion.ai/v1
FLOOR_LLM_MODEL=aisingapore/Qwen-SEA-LION-v4.5-27B-IT

# signals/realtime_watcher.py — OPTIONAL always-on host (Kraken WS BTC/ETH).
# XAUUSD ticks/candles come from the MT5 EA → Vercel APIs; no Python on the VPS.
# On each 5m/15m/1h close, /api/mt5/candles dispatches the GitHub engine.
# Cron-job.org → /api/cron/trigger-engine remains the backup schedule.
#
# signals/live_scanner.py — OPTIONAL (not needed for EA-only VPS setups).
# LIVE_SCANNER_POLL_SECONDS=15
